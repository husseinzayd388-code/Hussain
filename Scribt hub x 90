-- سكربت طيران مخصص للهواتف مع ميزة التحكم بالسرعة (Mobile Fly Script with Speed Control)
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- إزالة أي واجهة طيران قديمة منعاً للتداخل
if PlayerGui:FindFirstChild("MobileFlyGui") then
    PlayerGui.MobileFlyGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MobileFlyGui"
ScreenGui.Parent = PlayerGui

-- دالة لإنشاء أزرار التحكم على الشاشة
local function createControlBtn(name, text, size, pos, color)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 15
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = text
    btn.BackgroundTransparency = 0.2
    btn.Parent = ScreenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn
    return btn
end

-- أزرار التحكم والسرعة على الشاشة
local ToggleBtn = createControlBtn("ToggleBtn", "تشغيل الطيران", UDim2.new(0, 130, 0, 40), UDim2.new(0.5, -65, 0, 15), Color3.fromRGB(0, 180, 0))
local SpeedDisplay = createControlBtn("SpeedDisplay", "السرعة: 55", UDim2.new(0, 130, 0, 35), UDim2.new(0.5, -65, 0, 60), Color3.fromRGB(40, 40, 40))
local SpeedUpBtn = createControlBtn("SpeedUp", "سرعة +", UDim2.new(0, 60, 0, 35), UDim2.new(0.5, 5, 0, 100), Color3.fromRGB(0, 120, 215))
local SpeedDownBtn = createControlBtn("SpeedDown", "سرعة -", UDim2.new(0, 60, 0, 35), UDim2.new(0.5, -65, 0, 100), Color3.fromRGB(215, 120, 0))

-- أزرار الحركة (صعود، نزول، تقدم، رجوع)
local upBtn = createControlBtn("UpBtn", "صعود (▲)", UDim2.new(0, 85, 0, 40), UDim2.new(1, -100, 0.4, -50), Color3.fromRGB(0, 120, 215))
local downBtn = createControlBtn("DownBtn", "نزول (▼)", UDim2.new(0, 85, 0, 40), UDim2.new(1, -100, 0.4, 5), Color3.fromRGB(180, 40, 40))
local forwardBtn = createControlBtn("FwdBtn", "تقدم", UDim2.new(0, 75, 0, 40), UDim2.new(0, 20, 0.65, -50), Color3.fromRGB(50, 50, 50))
local backBtn = createControlBtn("BckBtn", "رجوع", UDim2.new(0, 75, 0, 40), UDim2.new(0, 20, 0.65, 5), Color3.fromRGB(50, 50, 50))

-- متغيرات التحكم
local isFlying = false
local flySpeed = 55
local movingForward = false
local movingBackward = false
local movingUp = false
local movingDown = false

-- التحكم بزيادة وتقليل السرعة
SpeedUpBtn.MouseButton1Click:Connect(function()
    flySpeed = math.min(flySpeed + 15, 200) -- أقصى سرعة 200
    SpeedDisplay.Text = "السرعة: " .. flySpeed
end)

SpeedDownBtn.MouseButton1Click:Connect(function()
    flySpeed = math.max(flySpeed - 15, 15) -- أقل سرعة 15
    SpeedDisplay.Text = "السرعة: " .. flySpeed
end)

forwardBtn.MouseButton1Down:Connect(function() movingForward = true end)
forwardBtn.MouseButton1Up:Connect(function() movingForward = false end)
backBtn.MouseButton1Down:Connect(function() movingBackward = true end)
backBtn.MouseButton1Up:Connect(function() movingBackward = false end)
upBtn.MouseButton1Down:Connect(function() movingUp = true end)
upBtn.MouseButton1Up:Connect(function() movingUp = false end)
downBtn.MouseButton1Down:Connect(function() movingDown = true end)
downBtn.MouseButton1Up:Connect(function() movingDown = false end)

ToggleBtn.MouseButton1Click:Connect(function()
    isFlying = not isFlying
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        isFlying = false
        return 
    end
    
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    
    if isFlying then
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        ToggleBtn.Text = "إيقاف الطيران"
        
        if humanoid then humanoid.PlatformStand = true end
        
        local bv = Instance.new("BodyVelocity")
        bv.Name = "SpeedMobileFlyVel"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp
        
        local bg = Instance.new("BodyGyro")
        bg.Name = "SpeedMobileFlyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = hrp.CFrame
        bg.Parent = hrp
        
        task.spawn(function()
            while isFlying and char and hrp and hrp.Parent do
                RunService.RenderStepped:Wait()
                if hrp:FindFirstChild("SpeedMobileFlyVel") and hrp:FindFirstChild("SpeedMobileFlyGyro") then
                    local cam = workspace.CurrentCamera
                    local moveDir = Vector3.new(0, 0, 0)
                    
                    if movingForward then
                        moveDir = moveDir + cam.CFrame.LookVector
                    end
                    if movingBackward then
                        moveDir = moveDir - cam.CFrame.LookVector
                    end
                    if movingUp then
                        moveDir = moveDir + Vector3.new(0, 1, 0)
                    end
                    if movingDown then
                        moveDir = moveDir - Vector3.new(0, 1, 0)
                    end
                    
                    hrp.SpeedMobileFlyVel.Velocity = moveDir * flySpeed
                    hrp.SpeedMobileFlyGyro.CFrame = cam.CFrame
                end
            end
        end)
    else
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
        ToggleBtn.Text = "تشغيل الطيران"
        
        if humanoid then humanoid.PlatformStand = false end
        if hrp:FindFirstChild("SpeedMobileFlyVel") then hrp.SpeedMobileFlyVel:Destroy() end
        if hrp:FindFirstChild("SpeedMobileFlyGyro") then hrp.SpeedMobileFlyGyro:Destroy() end
    end
end)
